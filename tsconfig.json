{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": [
    "src/worker-main.ts",
    "src/repositories/d1.ts",
    "src/utils/socket-fetch.ts",
    "src/probe-*.ts"
  ]
}
