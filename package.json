{
  "name": "youtube-transcript-app",
  "version": "1.0.0",
  "type": "module",
  "description": "Local web application to view and download YouTube transcripts",
  "main": "src/node-main.ts",
  "scripts": {
    "start": "tsx src/node-main.ts",
    "dev": "tsx watch src/node-main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply youtube-transcript-d1 --local",
    "db:migrate:remote": "wrangler d1 migrations apply youtube-transcript-d1 --remote",
    "d1:export": "node scripts/export-sqlite-to-d1.mjs",
    "d1:seed:local": "wrangler d1 execute youtube-transcript-d1 --local --file=build/d1-seed.sql",
    "d1:seed:remote": "wrangler d1 execute youtube-transcript-d1 --remote --file=build/d1-seed.sql",
    "test": "node --import tsx --test test/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "@hono/node-server": "^2.1.7",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "hono": "^4.13.18",
    "marked": "^18.2.0",
    "undici": "^8.12.4",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wrangler": "^4.160.1"
  }
}
